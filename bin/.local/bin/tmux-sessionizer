#!/usr/bin/env bash
# Fuzzy-pick a project directory and open/switch to a tmux session named after it.
# Bound to Ctrl-F in zsh and prefix+f in tmux.

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # search roots, only those that exist on this machine
    roots=()
    for d in ~/work/baml ~/work ~/personal ~; do
        [[ -d $d ]] && roots+=("$d")
    done
    selected=$(find "${roots[@]}" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t "$selected_name" 2> /dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
